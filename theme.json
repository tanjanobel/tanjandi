{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "text": true,
            "background": true,
            "link": true,
            "defaultPalette": false,
            "palette": [
                {
                    "name": "Tinte",
                    "slug": "ink",
                    "color": "#2b2926"
                },
                {
                    "name": "Washi",
                    "slug": "washi",
                    "color": "#f6f3ee"
                },
                {
                    "name": "Beere dunkel",
                    "slug": "berry-dark",
                    "color": "#9a4a5e"
                },
                {
                    "name": "Beere hell",
                    "slug": "berry-light",
                    "color": "#c27f8f"
                },
                {
                    "name": "Sand",
                    "slug": "sand",
                    "color": "#ede7de"
                },
                {
                    "name": "Sand dunkel",
                    "slug": "sand-dark",
                    "color": "#e2d9cb"
                },
                {
                    "name": "Leinen",
                    "slug": "linen",
                    "color": "#e9e4dc"
                },
                {
                    "name": "Fliesstext",
                    "slug": "text-body",
                    "color": "#3f3b36"
                },
                {
                    "name": "Text sekundär",
                    "slug": "text-secondary",
                    "color": "#5e584f"
                },
                {
                    "name": "Text gedämpft",
                    "slug": "text-muted",
                    "color": "#6e675e"
                },
                {
                    "name": "Linie",
                    "slug": "line",
                    "color": "#d6cec2"
                },
                {
                    "name": "Linie hell",
                    "slug": "line-light",
                    "color": "#e4ddd2"
                }
            ],
            "gradients": [
                {
                    "name": "Subheader Verlauf",
                    "slug": "subheader-gradient",
                    "gradient": "linear-gradient(to right, rgba(43,41,38,0.98) 0%, rgba(43,41,38,0.96) 25%, rgba(43,41,38,0.90) 50%, rgba(43,41,38,0.80) 70%, rgba(43,41,38,0.70) 85%, rgba(43,41,38,0.65) 100%)"                }
            ]
        },
        "spacing": {
            "blockGap": true,
            "spacingSizes": [
                {
                    "size": "0",
                    "slug": "0",
                    "name": "0"
                },
                {
                    "size": "16px",
                    "slug": "1",
                    "name": "1"
                },
                {
                    "size": "32px",
                    "slug": "2",
                    "name": "2"
                },
                {
                    "size": "48px",
                    "slug": "3",
                    "name": "3"
                },
                {
                    "size": "64px",
                    "slug": "4",
                    "name": "4"
                },
                {
                    "size": "80px",
                    "slug": "5",
                    "name": "5"
                }
            ],
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        },
        "useRootPaddingAwareAlignments": true,
        "custom": {
            "typography": {
                "line-height": {
                    "body": 1.7,
                    "heading": 1.3,
                    "page-title": 1.1
                },
                "font-weight": {
                    "light": "300",
                    "normal": "400"
                },
                "font-size": {
                    "huge": "clamp(2.25rem, 4vw, 2.75rem)",
                    "gigantic": "clamp(2.75rem, 6vw, 3.25rem)",
                    "colossal": "clamp(3.25rem, 8vw, 6.25rem)"
                }
            }
        }
    },
    "styles": {
        "blocks": {
            "core/columns": {
                "spacing": {
                    "blockGap": "30px"
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "blank",
            "title": "Blank",
            "postTypes": [
                "page",
                "post"
            ]
        },
        {
            "name": "page-notitle",
            "title": "Seite: Ohne Titel",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "coming-soon",
            "title": "Coming Soon Seite",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "project-single",
            "title": "Projekt: Einzelseite",
            "postTypes": [
                "page",
                "post",
                "projekt",
                "project",
                "reference"
            ]
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "header-home",
            "title": "Header Home",
            "area": "header"
        },
        {
            "name": "header-transparent",
            "title": "Header Transparent",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        },
        {
            "name": "query",
            "title": "Query (The Loop)",
            "area": "query"
        },
        {
            "name": "subheader",
            "title": "Subheader",
            "area": "subheader"
        },
        {
            "name": "variable-product-add-to-cart-with-options",
            "title": "In den Warenkorb: Produkt mit Varianten",
            "area": "uncategorized"
        },
        {
            "name": "simple-product-add-to-cart-with-options",
            "title": "In den Warenkorb: Einfaches Produkt",
            "area": "uncategorized"
        }
    ]
}
