<div class="icon-button">
    {{# if icon_link}}
    <a href="{{icon_link}}" class="icon-button__link" target="{{icon_target}}" aria-label="{{icon_title}}">
    {{/if}}

    {{#if icon_width_mobile}}
        <svg
            role="img"
            class="icon-button__icon icon {{icon_color.slug}} hide-for-laptop"
            height="{{icon_width_mobile}}"
            width="{{icon_width_mobile}}"
        >
            <use xlink:href="/wp-content/themes/tanjandi/static/icons/symbol/icon-sprite.svg#{{icon_symbol}}"></use>
        </svg>
    {{/if}}
    {{#if icon_width}}
        <svg
            role="img"
            class="icon-button__icon icon {{icon_color.slug}} show-for-laptop"
            height="{{icon_width}}"
            width="{{icon_width}}"
        >
            <use xlink:href="/wp-content/themes/tanjandi/static/icons/symbol/icon-sprite.svg#{{icon_symbol}}"></use>
        </svg>
    {{/if}}
    {{# if icon_text}}
        <span class="icon-button__text {{icon_color.slug}}">
            {{icon_text}}
        </span>
    {{/if}}
    {{# if icon_link}}
    </a>
    {{/if}}
</div>
