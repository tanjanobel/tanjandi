{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "tanjandi/hero",
    "version": "0.1.0",
    "title": "Hero",
    "category": "theme",
    "icon": "superhero",
    "description": "Ein Hero-Bereich mit Hintergrundbild, Titel, Text und InnerBlocks.",
    "attributes": {
        "hero_intro": {
            "type": "string",
            "default": "Digital Design & Webentwicklung"
        },
        "hero_title": {
            "type": "string",
            "default": "Digital Design & Webentwicklung"
        },
        "hero_bg_image": {
            "type": "object"
        },
        "hero_bg_color": {
            "type": "string",
            "default": "white"
        },
        "hero_anchor": {
            "type": "string"
        },
        "hero_bg_video_url": {
            "type": "object",
            "default": {
                "url": "/wp-content/uploads/2026/03/nwe_short.mp4",
                "id": null
            }
        },
        "hero_bg_video_poster": {
            "type": "object"
        }
    },
    "example": {},
    "editorScript": "file:./editor.js",
    "supports": {
        "html": false,
        "anchor": true,
        "jsx": true
    },
    "textdomain": "tanjandi",
    "render": "file:./render.php"
}
